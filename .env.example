# ------------------------------------------------------------------
# LLM PROVIDER
# ------------------------------------------------------------------
LLM_PROVIDER=groq

# Model name used by the active provider above.
# Leave commented out to use the code default for the selected provider.
LLM_MODEL=llama-3.3-70b-versatile

# When LLM_PROVIDER=groq  (default — get a key from https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
