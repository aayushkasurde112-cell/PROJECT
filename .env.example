# Which provider to use in utils/llm.py:
LLM_PROVIDER=gemini

# Primary model name (used when LLM_PROVIDER=openai)
LLM_MODEL=gemini-2.5-flash
# Google API key — required for the primary provider.
# Never commit a real key here — this file is just a template.
GOOGLE_API_KEY=your-openai-api-key-here

