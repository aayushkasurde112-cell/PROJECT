# ------------------------------------------------------------------
# LLM PROVIDER
# utils/llm.py dispatches get_llm() on LLM_PROVIDER.
#
# Supported values (case-insensitive):
#   groq             (default in code)   → GROQ_API_KEY  + LLM_MODEL default: llama-3.3-70b-versatile
#   google | gemini                    → GOOGLE_API_KEY + LLM_MODEL default: gemini-2.0-flash
#   openai                            → OPENAI_API_KEY + LLM_MODEL default: gpt-4o-mini
# ------------------------------------------------------------------
LLM_PROVIDER=groq

# Model name used by the active provider above.
# Leave commented out to use the code default for the selected provider.
LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------
# API KEYS — one key per provider. Fill in ONLY the key for the
# provider you set LLM_PROVIDER to above.
# NEVER commit real values here — this is a placeholder-only template.
# Real keys belong in your local, gitignored .env file only.
# ------------------------------------------------------------------

# When LLM_PROVIDER=groq  (default — get a key from https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# When LLM_PROVIDER=google  (or gemini — get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-google-gemini-api-key-here

# When LLM_PROVIDER=openai  (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------
# LOOP DETECTOR (optional — utils/loop_detector.py)
# sentence-transformers embedding model used by calculate_loop_score().
# Default in code is all-MiniLM-L6-v2; override here only if needed.
# ------------------------------------------------------------------
# LOOP_DETECTOR_MODEL=all-MiniLM-L6-v2
